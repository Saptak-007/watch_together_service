# Copy this file to .env for local development and replace the placeholders.
# Do not put real credentials in this file or commit your .env file.
SOPHISTICATED_CODE=replace-with-a-long-random-shared-code
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Optional settings
# FRONTEND_ORIGIN=https://your-site.netlify.app
# DATA_DIR=C:\path\to\sidebyside-data
# MAX_UPLOAD_BYTES=1073741824
# MAX_STORED_BYTES=10737418240
# ROOM_EMPTY_TTL_SECONDS=1800
# MAX_ROOM_MEMBERS=20
# FLASK_DEBUG=0
# SOCKETIO_ALLOW_WEBSOCKET=0
